# ===========================================
# CloudTry 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ===========================================

# -------------------------------------------
# 数据库配置 (MySQL)
# -------------------------------------------
# 数据库连接URL (根据不同服务修改数据库名)
# service-user: cloudtry_user
# service-product: cloudtry_product
# service-order: cloudtry_order
DB_URL=jdbc:mysql://localhost:3307/cloudtry_user?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true

# 数据库用户名
DB_USERNAME=root

# 数据库密码 (必填，无默认值)
DB_PASSWORD=your_database_password_here

# 数据库连接池配置 (可选)
# DB_HIKARI_MINIMUM_IDLE=10
# DB_HIKARI_MAXIMUM_POOL_SIZE=50
# DB_HIKARI_IDLE_TIMEOUT=600000
# DB_HIKARI_MAX_LIFETIME=1800000
# DB_HIKARI_CONNECTION_TIMEOUT=30000

# -------------------------------------------
# Redis 配置
# -------------------------------------------
# Redis 主机地址
REDIS_HOST=localhost

# Redis 端口
REDIS_PORT=6379

# Redis 密码 (如果没有设置密码，留空即可)
REDIS_PASSWORD=

# Redis 数据库索引 (默认为0)
# REDIS_DATABASE=0

# Redis 连接池配置 (可选)
# REDIS_LETTUCE_POOL_MAX_ACTIVE=50
# REDIS_LETTUCE_POOL_MAX_IDLE=20
# REDIS_LETTUCE_POOL_MIN_IDLE=10
# REDIS_LETTUCE_POOL_MAX_WAIT=3000

# -------------------------------------------
# JWT 安全配置
# -------------------------------------------
# JWT 密钥 (必填，建议使用至少256位的随机字符串)
# 生成方式: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long

# JWT Token 过期时间（秒，默认7天）
# JWT_EXPIRATION=604800

# JWT Token 前缀（默认 Bearer）
# JWT_TOKEN_PREFIX=Bearer

# JWT Header 名称（默认 Authorization）
# JWT_HEADER=Authorization

# -------------------------------------------
# RocketMQ 配置
# -------------------------------------------
# RocketMQ Name Server 地址
ROCKETMQ_NAME_SERVER=localhost:9876

# RocketMQ 生产者组名（可选，各服务可自定义）
# ROCKETMQ_PRODUCER_GROUP=cloudtry-producer-group

# RocketMQ 消费者组名前缀（可选，各服务可自定义）
# ROCKETMQ_CONSUMER_GROUP_PREFIX=cloudtry-consumer-

# RocketMQ 主题配置
# ROCKETMQ_TOPIC_ORDER_NOTIFY=order-notify-topic
# ROCKETMQ_TOPIC_SECKILL=seckill-topic
# ROCKETMQ_TOPIC_VERIFY_CODE=verify-code-topic

# -------------------------------------------
# Seata 分布式事务配置
# -------------------------------------------
# Seata Server 地址
SEATA_SERVER_ADDR=127.0.0.1:8091

# Seata 应用ID（各服务应设置不同的值）
# SEATA_APPLICATION_ID=service-user

# Seata 事务分组（默认 my_test_tx_group）
# SEATA_TX_SERVICE_GROUP=my_test_tx_group

# Seata 服务组配置（vgroupMapping）
# SEATA_SERVICE_GROUP_MAPPING=my_test_tx_group

# -------------------------------------------
# Nacos 配置中心
# -------------------------------------------
# Nacos 服务地址
NACOS_SERVER_ADDR=localhost:8848

# Nacos 命名空间
NACOS_NAMESPACE=dev

# Nacos 配置分组
NACOS_GROUP=DEFAULT_GROUP

# Nacos 用户名（如果启用了认证）
# NACOS_USERNAME=nacos

# Nacos 密码（如果启用了认证）
# NACOS_PASSWORD=nacos

# -------------------------------------------
# Sentinel 流量控制配置
# -------------------------------------------
# Sentinel 控制台地址（可选）
# SENTINEL_DASHBOARD=localhost:8080

# Sentinel 端口（默认 8719）
# SENTINEL_PORT=8719

# Sentinel 应用名称
# SENTINEL_APP_NAME=service-user

# -------------------------------------------
# 服务端口配置
# -------------------------------------------
# 网关服务端口
# GATEWAY_PORT=8080

# 用户服务端口
# SERVICE_USER_PORT=8001

# 商品服务端口
# SERVICE_PRODUCT_PORT=8002

# 订单服务端口
# SERVICE_ORDER_PORT=8003

# -------------------------------------------
# 日志配置
# -------------------------------------------
# 日志级别（DEBUG, INFO, WARN, ERROR）
# LOG_LEVEL_ROOT=INFO

# 日志文件路径
# LOG_PATH=/var/log/cloudtry

# -------------------------------------------
# 其他配置
# -------------------------------------------
# 应用环境（dev, test, prod）
# SPRING_PROFILES_ACTIVE=dev

# 是否启用调试模式
# DEBUG_MODE=false
